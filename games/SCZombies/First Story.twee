:: StoryStylesheet [stylesheet]
.line {
  display: flex;           /* puts children in a horizontal row */
  align-items: center;     /* vertical alignment */
  gap: 20px;               /* spacing between images */
}

.player1, .player2, .player3, .player4, .player5 {
  width: 160px;
  height: 160px;
}
.players{
  width: 64px;
  height: 64px;
}
.content {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  padding: 20px;             /* optional margin from edges */
  display: block;
  flex-direction: column;    /* stack elements vertically */
  justify-content: flex-start; /* top */
  align-items: flex-start;   /* left-align text */
  text-align: left;          /* left-align multi-line text */
}
.BG1 {
  position: fixed;          /* covers full screen */
  top: 0; 
  left: 0;
  width: 100vw;             /* full viewport width */
  height: 100vh;            /* full viewport height */
  background-image: url('pixel_art_empyt_school_campus.jpeg');
  background-size: cover;    /* fill while keeping aspect ratio */
  background-position: center;
  background-repeat: no-repeat;
  image-rendering: pixelated;

  display: flex;             /* optional, for aligning text or GIFs */
  flex-direction: column;
  justify-content: flex-start; 
  align-items: center; 
  padding: 20px;             /* spacing inside div */
  z-index: 0;                /* behind text */
}

.BG1::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.8);  /* dim background only */
  pointer-events: none;
  z-index: -1;                   /* behind text content */
}

